# Copy to .env and fill in. Every value is optional.

# Anthropic API key for answers, briefings and tagging. Can also be added in Settings by the platform owner.
ANTHROPIC_API_KEY=

# Fallback models. The platform owner normally chooses these in Settings → Platform → Models,
# and a choice made there takes priority over these lines.
# Options: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5
# Answering questions (also used for reading documents if the next line is blank):
POLICYPILOT_MODEL=claude-opus-5-5
# Reading documents (tags, categories, briefings):
POLICYPILOT_PROCESSING_MODEL=claude-haiku-5-5

# Who runs this PolicyPilot. The account with this email is the platform owner (AI key, PAL library,
# school invitations). If blank, the first account created becomes the owner.
OWNER_EMAIL=

# New schools: "invite" (default: needs an invitation link from the owner) or "open" (anyone can set one up).
SCHOOL_SIGNUP=invite

# Optional: only allow sign-ups from these email domains, comma-separated (the owner is always allowed).
# e.g. ALLOWED_EMAIL_DOMAINS=education.vic.gov.au
ALLOWED_EMAIL_DOMAINS=

# Where the database, uploads, daily backups and the local embedding model are stored.
POLICYPILOT_DATA_DIR=data

# Port for the production server (npm start). In development the API runs on API_PORT (default 3011) behind Vite on 5173.
PORT=3011
