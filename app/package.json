{
  "name": "policypilot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "reset-password": "node --env-file-if-exists=.env scripts/reset-password.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@huggingface/transformers": "^4.3.2",
    "@vitejs/plugin-react": "^6.3.0",
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "lucide-react": "^1.77.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "remark-gfm": "^4.0.1",
    "unpdf": "^2.2.1",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
